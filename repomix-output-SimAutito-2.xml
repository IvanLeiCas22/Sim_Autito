QString csvEscaped(QString value)
{
    const bool needsQuotes = value.contains(',')
        || value.contains('"')
        || value.contains('\n')
        || value.contains('\r');
    value.replace("\"", "\"\"");
    return needsQuotes ? QString("\"%1\"").arg(value) : value;
}

