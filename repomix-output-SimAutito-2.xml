#ifndef NAV_SUPERVISOR_H
#define NAV_SUPERVISOR_H

#include <stdbool.h>
#include <stdint.h>

#include "nav_core.h"
#include "nav_frontier_eval.h"
#include "nav_goal_return_eval.h"

#ifdef __cplusplus
extern "C" {
