namespace {
constexpr double kDegToRad = 3.14159265358979323846 / 180.0;
constexpr double kEpsilon = 1.0e-9;
constexpr double kTapeWidthMm = 20.0;
constexpr double kTapeHalfWidthMm = kTapeWidthMm / 2.0;
